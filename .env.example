# 환경 분기 (정보용 — lifespan 자동 분기는 PR #14 에서 제거됨)
ENVIRONMENT=development

# 데이터베이스
DATABASE_URL=sqlite+aiosqlite:///./app.db
# DB_ECHO: true 면 SQL 로그 출력 (디버깅용)
DB_ECHO=false

# JWT
SECRET_KEY=your-secret-key
# 토큰 만료 (분)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# bcrypt 해시 라운드 (4 ~ 31). 운영은 12 ~ 13 권장.
# 다운그레이드는 자동 차단 (PR #13).
# 비밀번호 해싱 비용 증가 = 무차별 대입 공격 비용 증가 / API 응답 지연 증가
BCRYPT_ROUNDS=12

# 응답 PII 정책 (PR #22) — UserAdminView 의 email 마스킹.
# false 명시 시 raw email (dev 디버깅 전용, 운영은 true 유지).
USER_ADMIN_EMAIL_MASKING=true

# 로깅 (PR #23) — app/core/logging.py::setup_logging 가 참조.
LOG_LEVEL=INFO    # DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_FORMAT=text   # text (사람 친화 colorized) / json (수집 파이프라인)
# 아래 3개는 default 미설정 (stderr 만). 활성화는 의도적 선택.
# LOG_FILE=/var/log/app.log
# LOG_FILE_ROTATION=10 MB     # loguru rotation 문법 (예: 1 day)
# LOG_FILE_RETENTION=7 days   # loguru retention 문법

# 관측성 (PR ##) — Sentry 통합 (Error + Performance + Profiling).
# DSN 빈 값 = 비활성 (default). 운영 활성화 시 DSN + sample_rate 만 조정.
# app/core/observability.py::setup_sentry 가 단일 진입점.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development           # development / staging / production
# Performance — 0.0 비활성 / 운영 권장 0.1 / staging 1.0
SENTRY_TRACES_SAMPLE_RATE=0.0
# Profiling — Performance 가 활성화된 경우만 수집 (sample_rate > 0)
SENTRY_PROFILES_SAMPLE_RATE=0.0
# Release tag (CI 가 git sha 주입 가능)
# SENTRY_RELEASE=
# Sentry default PII (IP / Cookies 등) 전송 — 도메인 PII (email 등) 는 별도 redact
SENTRY_SEND_PII=false

# --- list endpoint 페이징 정책 (PR ##) ---
# 자원별 default — 화면 / UI 정책에 맞게 튜닝.
USER_LIST_DEFAULT_LIMIT=100
PRODUCT_LIST_DEFAULT_LIMIT=100
# 공통 max — offset 모드 limit + page 모드 per_page 양쪽 상한 (DoS 가드).
# 자원별 default 는 이 값 이하여야 함 (model_validator fail-fast).
LIST_MAX_LIMIT=1000

# OAuth (현재 코드 미사용 — 향후 도입 후보)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
